# Copier ce fichier en .env.local (en local) et renseigner les mêmes variables dans Vercel.

# Clé d'accès Web3Forms (gratuite, https://web3forms.com) : reçoit les demandes de devis par email.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Adresse définitive du site (sans / final), utilisée pour le SEO, le sitemap et Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.euralu.fr
